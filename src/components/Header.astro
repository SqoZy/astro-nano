---
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import { SITE } from "@consts";
---

<header>
  <Container>
    <div class="flex flex-wrap gap-y-2 justify-start items-center">
      <a
        href="/"
        id="logo-button"
        class="logo-button"
        aria-label="Home - Click to cycle wisp"
      >
        <img
          id="logo-image"
          src="data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs="
          alt="Wisp logo"
          class="logo-image"
        />
      </a>

      <nav class="flex gap-1 items-center ml-auto">
        <Link href="/about" class="hover-box">about</Link>
        <Link href="/blog" class="hover-box">blog</Link>
        <Link href="/work" class="hover-box">work</Link>
        <Link href="/projects" class="hover-box">projects</Link>
        <button
          id="theme-toggle-button"
          aria-label="Toggle theme"
          class="group size-8 flex items-center justify-center rounded-full ml-2"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="group-hover:stroke-black group-hover:dark:stroke-white transition-colors duration-300 ease-in-out"
          >
            <!-- Light Theme Icon -->
            <g class="light-icon">
              <circle cx="12" cy="12" r="5"></circle>
              <line x1="12" y1="1" x2="12" y2="3"></line>
              <line x1="12" y1="21" x2="12" y2="23"></line>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
              <line x1="1" y1="12" x2="3" y2="12"></line>
              <line x1="21" y1="12" x2="23" y2="12"></line>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
            </g>

            <!-- Dark Theme Icon -->
            <path
              d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
              class="dark-icon hidden"></path>
          </svg>
        </button>
      </nav>
    </div>
  </Container>
</header>

<script>
  const wispsIdle = [
    "/icons/idle/Poison_wisp_idle.gif",
    "/icons/idle/Poison_wisp_purple_idle.gif",
    "/icons/idle/Poison_wisp_red_idle.gif",
  ];
  const wispsDie = [
    "/icons/die/Poison_wisp_die.gif",
    "/icons/die/Poison_wisp_purple_die.gif",
    "/icons/die/Poison_wisp_red_die.gif",
  ];
  const wispSpawn = [
    "/icons/spawn/Poison_wisp_spawn.gif",
    "/icons/spawn/Poison_wisp_purple_spawn.gif",
    "/icons/spawn/Poison_wisp_red_spawn.gif",
  ];
  const wispDieAnimationDuration = 900;
  const wispSpawnAnimationDuration = 700;
  let wispChangeInProgress = false;

  function getStoredWisp() {
    const saved = Number(localStorage.getItem("wisp") ?? "0");
    return Number.isInteger(saved) && saved >= 0 ? saved : 0;
  }

  function hasWispSpawned() {
    return localStorage.getItem("wispSpawned") === "true";
  }

  async function setWispImage(src: string) {
    const logoImage = document.getElementById(
      "logo-image",
    ) as HTMLImageElement | null;
    if (!logoImage) {
      return Promise.resolve();
    }

    const nextLogoImage = logoImage.cloneNode(false) as HTMLImageElement;
    nextLogoImage.src = src;

    if (!nextLogoImage.complete) {
      await new Promise<void>((resolve) => {
        nextLogoImage.addEventListener("load", () => resolve(), { once: true });
        nextLogoImage.addEventListener("error", () => resolve(), {
          once: true,
        });
      });
    }

    logoImage.replaceWith(nextLogoImage);
  }

  async function playWispAnimation(src: string, duration: number) {
    await setWispImage(src);
    await new Promise((resolve) => setTimeout(resolve, duration));
  }

  async function spawnWisp(index: number) {
    await playWispAnimation(wispSpawn[index], wispSpawnAnimationDuration);
    await setWispImage(wispsIdle[index]);
    localStorage.setItem("wispSpawned", "true");
    wispChangeInProgress = false;
  }

  async function cycleWisp(event: MouseEvent) {
    event.preventDefault();
    if (wispChangeInProgress) return;

    wispChangeInProgress = true;
    const current = getStoredWisp() % wispsIdle.length;
    const next =
      wispsIdle.length > 1
        ? (current + 1 + Math.floor(Math.random() * (wispsIdle.length - 1))) %
          wispsIdle.length
        : current;

    localStorage.setItem("wispSpawned", "false");
    await playWispAnimation(wispsDie[current], wispDieAnimationDuration);

    localStorage.setItem("wisp", String(next));
    if (window.location.pathname === "/") {
      await spawnWisp(next);
    } else {
      wispChangeInProgress = false;
      window.location.href = "/";
    }
  }

  function initLogo() {
    const logoImage = document.getElementById(
      "logo-image",
    ) as HTMLImageElement | null;
    if (!logoImage) {
      return;
    }
    const index = getStoredWisp() % wispsIdle.length;
    console.log("Current wisp index:", index);

    if (!hasWispSpawned() && !wispChangeInProgress) {
      console.log("Spawning wisp for the first time");
      wispChangeInProgress = true;
      spawnWisp(index);
    } else if (hasWispSpawned()) {
      logoImage.src = wispsIdle[index];
    }

    const logoButton = document.getElementById("logo-button");
    if (logoButton) {
      logoButton.onclick = cycleWisp;
    }
  }

  // Initialize on page load
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initLogo);
  } else {
    initLogo();
  }

  // Re-initialize on Astro route transitions
  document.addEventListener("astro:page-load", initLogo);
</script>
